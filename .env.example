# edgeone-s3-site-statistics environment variable template
# Copy these into the EdgeOne Pages console: Project -> Settings -> Environment Variables.
#
# WARNING: this file lists variable names only. It contains no real values.
# WARNING: if you create a local .env for testing, keep it out of git (see .gitignore).

# ---- S3 (same values as edgeone-s3-proxy) ----
# S3 AccessKeyID (recommend setting the type to Secret)
AWS_ACCESS_KEY_ID=

# S3 AccessKeySecret (must be set as type Secret)
AWS_SECRET_ACCESS_KEY=

# Bucket name
S3_BUCKET=

# S3 endpoint hostname. No https:// prefix.
S3_ENDPOINT=

# Region used for signing. Default: cn-north-1
#S3_REGION=cn-north-1

# User-Agent prefix. The gateway gates on this; use the application name the
# key is bound to. Default: S3Drive
#UA_PREFIX=S3Drive

# ---- Statistics ----
# Key prefix inside the bucket. All stats objects live under it.
# Default: stats
#STATS_PREFIX=stats

# Secret used to hash visitor IPs. Recommended: 32+ random chars.
# Losing it only invalidates today's UV dedupe, nothing else. Never commit it.
STATS_SALT=

# Allowed browser origins, comma separated. Empty = allow any origin.
# Set this in production so other sites cannot inflate your counters.
#STATS_ORIGINS=https://zhiyuanzhou.top,https://www.zhiyuanzhou.top

# Token protecting POST /api/aggregate. Empty = that endpoint is disabled.
STATS_TOKEN=

# Token protecting the human pages: "/" and "/dashboard.html".
# Empty = both pages stay public. Independent from STATS_TOKEN (they may share a
# value, but changing this one only locks/unlocks the pages). A successful login
# sets an HttpOnly cookie for 12 hours, so the pages stay unlocked in a browser.
#STATS_ACCESS_TOKEN=

# UTC offset (hours) used to decide which calendar day a visit belongs to.
# Default: 8 (Asia/Shanghai)
#STATS_TZ_OFFSET=8

# Raw events are kept this many days before being deleted after aggregation.
# Daily/monthly/total JSON files are never deleted. Default: 7
#STATS_KEEP_DAYS=7

# How long a cached snapshot is served before refreshing in the background. Default: 60000
#STATS_SNAPSHOT_TTL_MS=60000

# ---- Optional snapshot cache (Pages Blob) ----
# On by default. Must use a DIFFERENT store than edgeone-s3-proxy's "s3-cache":
# that store FIFO-evicts any key missing from its own __index__ manifest.
#STATS_BLOB_CACHE=on
#STATS_BLOB_STORE=site-stats
